# Fastlane lanes for The Fort iOS app, run on GitHub Actions macOS runners.
#
# Signing is manual: one Apple Distribution cert kept as a password-protected p12 in the
# IOS_CERT_P12_B64 secret (minted once by mint_cert), plus an App Store profile fetched
# with the App Store Connect API key on every run.
#
# Run from native/ios:   fastlane ios beta
#
# Env (CI passes these from repo secrets):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (base64 .p8)   App Store Connect API key
#   APPLE_TEAM_ID                                        Apple Developer Team ID
#   IOS_CERT_P12_B64, CERT_EXPORT_PASS                   distribution cert and its password
#   BUILD_NUMBER (optional)   CURRENT_PROJECT_VERSION; a timestamp when absent

require "base64"
require "tmpdir"

default_platform(:ios)

TMP_KEYCHAIN = File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db")

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    is_key_content_base64: true
  )
end

platform :ios do
  desc "Build the App scheme and upload to TestFlight (manual p12 signing)"
  lane :beta do
    # On CI, a temporary default keychain for the imported cert. No-op locally.
    setup_ci
    api_key = asc_api_key

    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    # Automatic signing archives with a Development profile, which needs a registered
    # device this team doesn't have; an App Store profile needs none. Runners are wiped
    # after each run and a fresh cert per run hits Apple's distribution-cert cap, so the
    # one cert lives in the IOS_CERT_P12_B64 secret.
    p12_path = File.join(Dir.mktmpdir("cert"), "dist.p12")
    File.binwrite(p12_path, Base64.decode64(ENV.fetch("IOS_CERT_P12_B64")))
    import_certificate(
      certificate_path: p12_path,
      # macOS `security import` fails MAC verification on passwordless / OpenSSL-3 p12s.
      certificate_password: ENV.fetch("CERT_EXPORT_PASS"),
      keychain_path: TMP_KEYCHAIN,
      keychain_password: ""
    )
    # The cert's issuer; without it a bare runner reports "no local code signing identities".
    wwdr_path = File.join(Dir.mktmpdir("wwdr"), "AppleWWDRCAG3.cer")
    sh("curl", "-fsSL", "https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer", "-o", wwdr_path)
    import_certificate(
      certificate_path: wwdr_path,
      keychain_path: TMP_KEYCHAIN,
      keychain_password: ""
    )
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: bundle_id,
      force: true,
      filename: "appstore.mobileprovision"
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: "App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["App"],
      bundle_identifier: bundle_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      project: "App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      output_directory: "build",
      output_name: "App.ipa",
      # The runner's fastlane rejected the newer "app-store-connect" name.
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: { bundle_id => profile_name },
        uploadSymbols: true
      },
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "ONE-TIME: mint the Apple Distribution cert; saves build/dist_full.p12 (CERT_EXPORT_PASS)"
  lane :mint_cert do
    setup_ci
    api_key = asc_api_key
    # cert()'s ".p12" is a bare PEM private key beside a separate .cer; combine them into a
    # real PKCS12 identity, or import_certificate yields a key with no cert.
    cert(
      api_key: api_key,
      output_path: "build",
      keychain_path: TMP_KEYCHAIN,
      keychain_password: ""
    )
    key_file = Dir["build/*.p12"].reject { |f| f.end_with?("dist_full.p12") }.first
    cer_file = Dir["build/*.cer"].first
    UI.user_error!("cert() outputs not found in build/") unless key_file && cer_file
    sh("openssl x509 -inform DER -in #{cer_file.shellescape} -out build/cert.pem")
    # -passout env keeps the password out of the logged command line; macOS LibreSSL
    # already exports a legacy-compatible p12.
    sh("openssl pkcs12 -export -inkey #{key_file.shellescape} -in build/cert.pem -passout env:CERT_EXPORT_PASS -out build/dist_full.p12")
  end
end
